[Unit]
Description=benchboss web app for %i (listens on localhost; Caddy adds HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
# One instance per Linux user: benchboss-web@alice runs as alice with alice's settings.
User=%i
WorkingDirectory=/home/%i
# BB_PORT, BB_URL and optionally BB_ARGS (extra options, for example GitHub sign in) and
# BENCHBOSS_GITHUB_CLIENT_SECRET. Written by `benchboss-users add`.
EnvironmentFile=/etc/benchboss/%i.env
ExecStart=/opt/benchboss/current/bin/benchboss web --host 127.0.0.1 --port ${BB_PORT} --url ${BB_URL} --password-file /home/%i/.bb-web-password $BB_ARGS
Restart=on-failure
RestartSec=5
# Every browser tab runs its own app process (about 70 MB): cap them so a small server keeps
# SSH and Caddy alive. Tune to the server's memory.
MemoryHigh=300M
MemoryMax=350M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
